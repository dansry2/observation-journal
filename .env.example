# Учётные данные администратора
# При первом запуске скопируйте этот файл в .env и задайте свой пароль
ADMIN_USERNAME=admin
ADMIN_PASSWORD=придумайте_свой_пароль

# Настройки базы данных (не трогайте если используете SQLite)
DATABASE_URL=sqlite:///./journal.db

# Секретный ключ для JWT токенов (придумайте случайную строку)
SECRET_KEY=change-me-in-production-please
